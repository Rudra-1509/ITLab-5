{
  "name": "project5-multiplayer-platform",
  "version": "1.0.0",
  "description": "Multiplayer Game Platform - Monorepo root",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "install:all": "npm --prefix backend install && npm --prefix frontend install",
    "dev": "npm --prefix backend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build:frontend": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "start:backend": "npm --prefix backend start",
    "start:frontend": "npm --prefix frontend run preview",
    "test": "node backend/test-demo.js && node database/tests/repositoryContract.test.js",
    "test:backend": "npm --prefix backend run test",
    "test:database": "node database/tests/repositoryContract.test.js",
    "seed:db": "node database/scripts/seed.js"
  }
}
